# Normalize line endings to LF in the repo; checkout as-is on all platforms
* text=auto eol=lf

# Binary files — never touch line endings
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.webm binary
*.pdf binary
*.zip binary
