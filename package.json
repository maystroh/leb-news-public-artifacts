{
  "name": "video-animations",
  "version": "1.0.0",
  "description": "Prototype daily briefing video animations",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "briefing:prepare": "node ./scripts/prepare-briefing.mjs",
    "briefing:build:full-editorial": "node ./scripts/build-full-editorial-html.mjs",
    "briefing:build:quote-duel": "node ./scripts/build-quote-duel-html.mjs",
    "briefing:build:folder": "node ./scripts/build-briefing-folder.mjs",
    "briefing:build:fault-line-map": "node ./scripts/prepare-briefing.mjs && node ./scripts/build-fault-line-map-html.mjs",
    "briefing:build:keyword-radar": "node ./scripts/prepare-briefing.mjs && node ./scripts/build-keyword-radar-html.mjs",
    "briefing:generate:all": "node ./scripts/generate-all-briefing-formats.mjs",
    "briefing:validate:analysis": "node ./scripts/validate-briefing-analysis-files.mjs",
    "briefing:workflow": "bash ./scripts/guided-briefing-workflow.sh",
    "briefing:dashboard": "node ./dashboard/server.mjs",
    "briefing:dashboard:build": "vite build --config dashboard/web/vite.config.mjs",
    "briefing:dashboard:dev": "vite --config dashboard/web/vite.config.mjs",
    "briefing:image:prompt": "node ./scripts/create-summary-image-prompt.mjs",
    "briefing:image:wire": "node ./scripts/wire-summary-image.mjs",
    "briefing:formats": "node ./scripts/launch-briefing-format.mjs --list",
    "briefing:launch": "node ./scripts/launch-briefing-format.mjs",
    "briefing:duel:hooks": "node ./scripts/generate-duel-hooks.mjs",
    "briefing:duel:build": "node ./scripts/build-quote-duel-folder.mjs",
    "briefing:duel:audio": "node ./scripts/generate-quote-duel-audio.mjs",
    "briefing:duel:render": "node ./scripts/render-quote-duel-video.mjs",
    "briefing:duel:mux:audio": "node ./scripts/mux-quote-duel-audio.mjs",
    "briefing:duel:split": "node ./scripts/split-quote-duel-video.mjs",
    "briefing:duel:captions": "node ./scripts/build-duel-social-captions-prompt.mjs",
    "briefing:duel:social:validate": "node ./scripts/validate-duel-social-captions.mjs",
    "briefing:duel:social-prompts": "node ./scripts/build-duel-social-prompts-prompt.mjs",
    "briefing:duel:social-prompts:validate": "node ./scripts/validate-duel-social-prompts.mjs",
    "briefing:render:mp4": "node ./scripts/render-briefing-video.mjs",
    "briefing:render:intro": "node ./scripts/render-briefing-intro-video.mjs",
    "intro:channel:render": "node ./scripts/render-channel-intro.mjs",
    "briefing:mux:audio": "node ./scripts/mux-briefing-audio.mjs",
    "briefing:split:mp4": "node ./scripts/split-briefing-video.mjs",
    "briefing:social:prompt": "node ./scripts/build-social-captions-prompt.mjs",
    "briefing:social:validate": "node ./scripts/validate-social-captions.mjs",
    "briefing:social:thumbnail-prompt": "node ./scripts/write-youtube-thumbnail-prompt.mjs",
    "briefing:social:zip": "node ./scripts/package-social-zip.mjs",
    "narration:prepare": "npm run briefing:prepare && node ./scripts/prepare-narration.mjs",
    "audio:generate:dry": "npm run narration:prepare && node ./scripts/generate-voiceover.mjs --dry-run",
    "audio:generate": "npm run narration:prepare && node ./scripts/generate-voiceover.mjs",
    "audio:outlets": "node ./audio/generate-outlet-audio.mjs",
    "audio:scene:guide": "node ./scripts/scene-audio-guide.mjs",
    "audio:script": "node ./scripts/build-audio-script.mjs",
    "audio:fix:headers": "node ./scripts/fix-wav-headers.mjs",
    "article:screenshot": "python3 ./scripts/article-screenshot.py",
    "logos:prepare": "node ./scripts/prepare-logos.mjs",
    "video:studio": "npm run briefing:prepare && remotion studio src/index.jsx",
    "video:render": "npm run briefing:prepare && remotion render src/index.jsx BriefingDaily out/briefing-daily.mp4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "4.0.471",
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "mp3-duration": "^1.1.0",
    "openai": "^6.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.471",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "puppeteer-core": "^25.3.0",
    "vite": "^8.0.16"
  }
}
